# Database connection
# For local zero-setup dev: SQLite
DATABASE_URL="file:./dev.db"

# For production / Vercel with PostgreSQL / Neon / Supabase:
# DATABASE_URL="postgresql://user:password@host:port/homeorx?schema=public&sslmode=require"

# NextAuth / App Secret (generate with openssl rand -base64 32)
AUTH_SECRET="homeorx-secret-key-development-placeholder-replace-in-production"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
